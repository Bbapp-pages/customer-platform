NODE_ENV=development
PORT=3000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/whatsapp_ai

# AI
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite

# WhatsApp (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_NUMBER=+14155238886
TWILIO_CONTACT_TEMPLATE_SID=your-approved-content-template-sid
TWILIO_FEEDBACK_TEMPLATE_SID=your-approved-content-template-sid

# Email (confirmación de citas)
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=onboarding@resend.dev

# Calendar
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Auth (admin dashboard)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# Used only by scripts/seed-admin.js to create the first admin
ADMIN_SEED_NAME=Administrador
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=changeme123

# Fixed 8-digit code required to create a new admin account from the dashboard.
ADMIN_SIGNUP_CODE=your-fixed-8-digit-code