NODE_ENV=development
PORT=3000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/whatsapp_ai

# AI
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite

# WhatsApp
WHATSAPP_PHONE_NUMBER_ID=1301483429709393
WHATSAPP_BUSINESS_ACCOUNT_ID=1528519271933675
WHATSAPP_ACCESS_TOKEN=token_id
WHATSAPP_API_VERSION=v25.0
WHATSAPP_VERIFY_TOKEN=whatsapp_ai_backend_2026

# Calendar
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Auth (admin dashboard)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# Used only by scripts/seed-admin.js to create the first admin
ADMIN_SEED_NAME=Administrador
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=changeme123